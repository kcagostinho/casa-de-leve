rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // O documento do grupo: quem tem o id (o link de convite) lê e edita; ninguém lista nem apaga.
    // (Sem listagem, não dá pra descobrir ids de grupos.)
    match /groups/{gid} {
      allow get, create, update: if request.auth != null;
      allow list, delete: if false;
    }

    // Subcoleções do grupo (members, bills, fridge, receipts, events = índice): exatamente um nível abaixo.
    // Não usar {document=**} aqui: o curinga recursivo casa também com o próprio /groups/{gid}
    // e liberaria list/delete do grupo.
    match /groups/{gid}/{collection}/{docId} {
      allow read, write: if request.auth != null;
    }

    // Eventos (churrasco etc.): coleção de topo, SEM referência ao grupo — o link do evento (#e=<eid>)
    // dá acesso só ao evento, nunca às contas do grupo. Ninguém lista eventos.
    match /events/{eid} {
      allow get, create, update, delete: if request.auth != null;
      allow list: if false;
    }
    match /events/{eid}/{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
